# LumaPay workspace configuration template.
# Copy only the relevant values into each package's private .env file.
# Never place a mnemonic, wallet seed, auth secret, private key, or populated
# service-role key in this tracked example.

MIDNIGHT_NETWORK=preprod
MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300
MIDNIGHT_DUST_SYNC_TIMEOUT_MS=10800000
LUMAPAY_DUST_STATE_OUTPUT_FILE=contracts/lumapay/deployments/preprod-dust-state.json
# Reuse this after the first snapshot exists to avoid replaying DUST sync from genesis.
# LUMAPAY_DUST_STATE_FILE=contracts/lumapay/deployments/preprod-dust-state.json
MIDNIGHT_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql
MIDNIGHT_INDEXER_WS=wss://indexer.preprod.midnight.network/api/v4/graphql/ws
MIDNIGHT_NODE=https://rpc.preprod.midnight.network
MIDNIGHT_NODE_WS=wss://rpc.preprod.midnight.network

# Current public Midnight Preprod deployment.
LUMAPAY_INVOICE_CORE_CONTRACT_ADDRESS=252404b3ad5a4f02071bb59d3631a86419cf6c6d1b995ccebe78399fe44000b2
LUMAPAY_CAMPAIGNS_CONTRACT_ADDRESS=c7ecd023012aaa863f6c8150d55366aed88e2347f47affbb1c71ccdb5dfbd43a
LUMAPAY_GIFT_CARDS_CONTRACT_ADDRESS=5600a4fc947cc5f56f8c2c8540de86e744f74f01e7befd400f7fd7ce41097d37
LUMAPAY_QUOTE_CHECKOUT_CONTRACT_ADDRESS=b75d261021ec1b56b68ff7167e811f7fdd3bf97e17ae26fb1188a8cb7b2c886a
LUMAPAY_BACKUP_ANCHOR_CONTRACT_ADDRESS=9b9879c4d0c3aa79ec6dbea8e6b1fe8b4c7391ad5cfa319eb7f0a34bd1e0b16d
LUMAPAY_CARD_VAULT_CONTRACT_ADDRESS=

# Backend placeholders.
PORT=3000
FRONTEND_URL=http://localhost:5173
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ENCRYPTION_KEY=
LUMAPAY_RECONCILIATION_SECRET=
LUMAPAY_RECONCILER_ENABLED=true
LUMAPAY_RECONCILIATION_INTERVAL_MS=15000
LUMAPAY_AUTH_CHALLENGE_TTL_MS=300000
LUMAPAY_AUTH_SESSION_TTL_MS=43200000

# Frontend aliases use the same public contract identifiers.
VITE_API_URL=http://127.0.0.1:3000
VITE_LUMAPAY_INVOICE_CORE_CONTRACT_ADDRESS=252404b3ad5a4f02071bb59d3631a86419cf6c6d1b995ccebe78399fe44000b2
VITE_LUMAPAY_CAMPAIGNS_CONTRACT_ADDRESS=c7ecd023012aaa863f6c8150d55366aed88e2347f47affbb1c71ccdb5dfbd43a
VITE_LUMAPAY_GIFT_CARDS_CONTRACT_ADDRESS=5600a4fc947cc5f56f8c2c8540de86e744f74f01e7befd400f7fd7ce41097d37
VITE_LUMAPAY_QUOTE_CHECKOUT_CONTRACT_ADDRESS=b75d261021ec1b56b68ff7167e811f7fdd3bf97e17ae26fb1188a8cb7b2c886a
VITE_LUMAPAY_BACKUP_ANCHOR_CONTRACT_ADDRESS=9b9879c4d0c3aa79ec6dbea8e6b1fe8b4c7391ad5cfa319eb7f0a34bd1e0b16d
