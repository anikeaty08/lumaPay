{
  "name": "@lumapay/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./managed/*": "./dist/managed/*"
  },
  "files": [
    "dist",
    "src/*.compact",
    ".compact-version",
    "README.md"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "npm run compile:suite:wsl",
    "compile:core:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compile-core-wsl.ps1",
    "generate:suite": "node scripts/generate-contract-suite.mjs",
    "compile:suite:wsl": "npm run generate:suite && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compile-suite-wsl.ps1",
    "compile:wsl": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/compile-wsl.ps1",
    "build": "tsc -p tsconfig.json && node scripts/copy-artifacts.mjs",
    "typecheck:deploy": "tsc -p tsconfig.deploy.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "proof:preprod": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-proof-server.ps1",
    "deploy:preprod:check": "node --env-file-if-exists=.env --import tsx scripts/deploy-preprod.ts --check",
    "deploy:preprod": "node --env-file-if-exists=.env --import tsx scripts/deploy-preprod.ts",
    "deploy:suite:preprod": "node --env-file-if-exists=.env --import tsx scripts/deploy-suite-preprod.mjs",
    "smoke:preprod": "node --env-file-if-exists=.env --import tsx scripts/smoke-preprod.ts",
    "verify": "npm run compile:wsl && npm run compile:core:wsl && npm run compile:suite:wsl && npm run build && npm run typecheck:deploy && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "rxjs": "7.8.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/ws": "8.18.1",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  }
}
