pragma language_version 0.23;



import CompactStandardLibrary;



// Generated from lumapay.compact for the deployable quote-checkout module.

export enum InvoiceStatus { OPEN, SETTLED, CANCELLED, EXPIRED }

export struct InvoicePublicState {
    commitmentVersion: Uint<16>;
    commitment: Bytes<32>;
    merchantAuthorization: Bytes<32>;
    expiry: Uint<64>;
    status: InvoiceStatus;
    settlementNullifier: Bytes<32>;
    escrowCoinCommitment: Bytes<32>;
    receiptCommitment: Bytes<32>;
    claimed: Boolean;
}

export struct QuotePublicState {
    commitmentVersion: Uint<16>;
    commitment: Bytes<32>;
    providerId: Bytes<32>;
    expiry: Uint<64>;
    consumed: Boolean;
}

export ledger invoiceIds: Set<Bytes<32>>;
export ledger invoices: Map<Bytes<32>, InvoicePublicState>;
export ledger paymentNullifiers: Set<Bytes<32>>;
export ledger claimNullifiers: Set<Bytes<32>>;
export ledger quoteIds: Set<Bytes<32>>;
export ledger quotes: Map<Bytes<32>, QuotePublicState>;
export ledger quoteProviderIds: Set<Bytes<32>>;
export ledger quoteProviderAuthorizations: Map<Bytes<32>, Bytes<32>>;
export ledger registryAdminAuthorization: Bytes<32>;

constructor(registryAdminAuthorizationCommitment: Bytes<32>) {
    assert(registryAdminAuthorizationCommitment != default<Bytes<32>>, "registry admin authorization is required");
    registryAdminAuthorization = disclose(registryAdminAuthorizationCommitment);
}

export pure circuit deriveMerchantAuthorization(merchantClaimSecret: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>([
        pad(32, "lumapay:merchant-auth:v1"),
        merchantClaimSecret
    ]);
}

export pure circuit deriveRegistryAdminAuthorization(adminSecret: Bytes<32>): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>]>([
        pad(32, "lumapay:registry-admin:v1"),
        adminSecret
    ]);
}

export pure circuit deriveQuoteProviderAuthorization(
    providerId: Bytes<32>,
    providerSecret: Bytes<32>
): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>]>([
        pad(32, "lumapay:quote-provider:v1"),
        providerId,
        providerSecret
    ]);
}

export pure circuit deriveInvoiceCommitment(
    invoiceId: Bytes<32>,
    merchantPrivateIdentity: Bytes<32>,
    amount: Uint<128>,
    tokenId: Bytes<32>,
    invoiceNonce: Bytes<32>,
    randomness: Bytes<32>,
    expiry: Uint<64>
): Bytes<32> {
    return persistentHash<[
        Bytes<32>, Uint<16>, Bytes<32>, Bytes<32>, Uint<128>,
        Bytes<32>, Bytes<32>, Bytes<32>, Uint<64>
    ]>([
        pad(32, "lumapay:invoice-commitment:v1"),
        1,
        invoiceId,
        merchantPrivateIdentity,
        amount,
        tokenId,
        invoiceNonce,
        randomness,
        expiry
    ]);
}

export pure circuit derivePaymentNullifier(
    invoiceId: Bytes<32>,
    paymentSecret: Bytes<32>
): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>]>([
        pad(32, "lumapay:payment-nullifier:v1"),
        invoiceId,
        paymentSecret
    ]);
}

export pure circuit deriveClaimNullifier(
    invoiceId: Bytes<32>,
    merchantClaimSecret: Bytes<32>
): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>]>([
        pad(32, "lumapay:claim-nullifier:v1"),
        invoiceId,
        merchantClaimSecret
    ]);
}

export pure circuit deriveEscrowCoinCommitment(
    nonce: Bytes<32>,
    color: Bytes<32>,
    value: Uint<128>
): Bytes<32> {
    return persistentHash<[Bytes<32>, Bytes<32>, Bytes<32>, Uint<128>]>([
        pad(32, "lumapay:escrow-coin:v1"),
        nonce,
        color,
        value
    ]);
}

export pure circuit deriveReceiptCommitment(
    invoiceId: Bytes<32>,
    settlementNullifier: Bytes<32>,
    amount: Uint<128>,
    tokenId: Bytes<32>,
    receiptSecret: Bytes<32>
): Bytes<32> {
    return persistentHash<[
        Bytes<32>, Bytes<32>, Bytes<32>, Uint<128>, Bytes<32>, Bytes<32>
    ]>([
        pad(32, "lumapay:receipt:v1"),
        invoiceId,
        settlementNullifier,
        amount,
        tokenId,
        receiptSecret
    ]);
}

export pure circuit deriveQuoteCommitment(
    quoteId: Bytes<32>,
    providerId: Bytes<32>,
    invoiceId: Bytes<32>,
    requestedToken: Bytes<32>,
    requestedAmount: Uint<128>,
    paymentToken: Bytes<32>,
    acceptedPaymentAmount: Uint<128>,
    expiry: Uint<64>,
    randomness: Bytes<32>
): Bytes<32> {
    return persistentHash<[
        Bytes<32>, Uint<16>, Bytes<32>, Bytes<32>, Bytes<32>, Bytes<32>,
        Uint<128>, Bytes<32>, Uint<128>, Uint<64>, Bytes<32>
    ]>([
        pad(32, "lumapay:quote-commitment:v1"),
        1,
        quoteId,
        providerId,
        invoiceId,
        requestedToken,
        requestedAmount,
        paymentToken,
        acceptedPaymentAmount,
        expiry,
        randomness
    ]);
}

export circuit createInvoice(
    invoiceId: Bytes<32>,
    invoiceCommitment: Bytes<32>,
    merchantAuthorizationCommitment: Bytes<32>,
    expiry: Uint<64>
): [] {
    assert(invoiceId != default<Bytes<32>>, "invoice id is required");
    assert(invoiceCommitment != default<Bytes<32>>, "invoice commitment is required");
    assert(
        merchantAuthorizationCommitment != default<Bytes<32>>,
        "merchant authorization is required"
    );
    assert(!invoiceIds.member(disclose(invoiceId)), "invoice already exists");
    assert(blockTimeLt(disclose(expiry)), "expiry must be in the future");

    invoiceIds.insert(disclose(invoiceId));
    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: 1,
        commitment: disclose(invoiceCommitment),
        merchantAuthorization: disclose(merchantAuthorizationCommitment),
        expiry: disclose(expiry),
        status: InvoiceStatus.OPEN,
        settlementNullifier: default<Bytes<32>>,
        escrowCoinCommitment: default<Bytes<32>>,
        receiptCommitment: default<Bytes<32>>,
        claimed: false
    });
}

export circuit payInvoice(
    invoiceId: Bytes<32>,
    merchantPrivateIdentity: Bytes<32>,
    amount: Uint<128>,
    tokenId: Bytes<32>,
    invoiceNonce: Bytes<32>,
    invoiceRandomness: Bytes<32>,
    paymentSecret: Bytes<32>,
    receiptSecret: Bytes<32>,
    coin: ShieldedCoinInfo
): [] {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    assert(invoice.status == InvoiceStatus.OPEN, "invoice is not open");
    assert(blockTimeLt(invoice.expiry), "invoice has expired");

    const expectedCommitment = deriveInvoiceCommitment(
        invoiceId,
        merchantPrivateIdentity,
        amount,
        tokenId,
        invoiceNonce,
        invoiceRandomness,
        invoice.expiry
    );
    assert(expectedCommitment == invoice.commitment, "invalid invoice opening");
    assert(amount > 0, "payment amount must be positive");
    assert(coin.value == amount, "wrong payment amount");
    assert(coin.color == tokenId, "wrong payment token");

    const nullifier = derivePaymentNullifier(invoiceId, paymentSecret);
    assert(!paymentNullifiers.member(disclose(nullifier)), "payment replay");

    receiveShielded(disclose(coin));
    paymentNullifiers.insert(disclose(nullifier));

    const escrowCommitment = deriveEscrowCoinCommitment(coin.nonce, coin.color, coin.value);
    const receipt = deriveReceiptCommitment(invoiceId, nullifier, amount, tokenId, receiptSecret);
    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: invoice.commitmentVersion,
        commitment: invoice.commitment,
        merchantAuthorization: invoice.merchantAuthorization,
        expiry: invoice.expiry,
        status: InvoiceStatus.SETTLED,
        settlementNullifier: disclose(nullifier),
        escrowCoinCommitment: disclose(escrowCommitment),
        receiptCommitment: disclose(receipt),
        claimed: false
    });
}

export circuit claimInvoice(
    invoiceId: Bytes<32>,
    merchantClaimSecret: Bytes<32>,
    escrowCoin: QualifiedShieldedCoinInfo
): ShieldedSendResult {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    assert(invoice.status == InvoiceStatus.SETTLED, "invoice is not settled");
    assert(!invoice.claimed, "invoice already claimed");
    assert(
        deriveMerchantAuthorization(merchantClaimSecret) == invoice.merchantAuthorization,
        "unauthorized claim"
    );
    assert(
        deriveEscrowCoinCommitment(escrowCoin.nonce, escrowCoin.color, escrowCoin.value)
            == invoice.escrowCoinCommitment,
        "wrong escrow coin"
    );

    const nullifier = deriveClaimNullifier(invoiceId, merchantClaimSecret);
    assert(!claimNullifiers.member(disclose(nullifier)), "claim replay");
    claimNullifiers.insert(disclose(nullifier));

    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: invoice.commitmentVersion,
        commitment: invoice.commitment,
        merchantAuthorization: invoice.merchantAuthorization,
        expiry: invoice.expiry,
        status: invoice.status,
        settlementNullifier: invoice.settlementNullifier,
        escrowCoinCommitment: invoice.escrowCoinCommitment,
        receiptCommitment: invoice.receiptCommitment,
        claimed: true
    });

    // The authenticated claimant is the receiver. Midnight can therefore create
    // the wallet-visible ciphertext without exposing a merchant payment identity.
    return sendShielded(
        disclose(escrowCoin),
        left<ZswapCoinPublicKey, ContractAddress>(ownPublicKey()),
        disclose(escrowCoin.value)
    );
}

export circuit cancelInvoice(invoiceId: Bytes<32>, merchantClaimSecret: Bytes<32>): [] {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    assert(invoice.status == InvoiceStatus.OPEN, "invoice is not open");
    assert(
        deriveMerchantAuthorization(merchantClaimSecret) == invoice.merchantAuthorization,
        "unauthorized cancellation"
    );

    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: invoice.commitmentVersion,
        commitment: invoice.commitment,
        merchantAuthorization: invoice.merchantAuthorization,
        expiry: invoice.expiry,
        status: InvoiceStatus.CANCELLED,
        settlementNullifier: invoice.settlementNullifier,
        escrowCoinCommitment: invoice.escrowCoinCommitment,
        receiptCommitment: invoice.receiptCommitment,
        claimed: invoice.claimed
    });
}

export circuit expireInvoice(invoiceId: Bytes<32>): [] {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    assert(invoice.status == InvoiceStatus.OPEN, "invoice is not open");
    assert(blockTimeGte(invoice.expiry), "invoice has not expired");

    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: invoice.commitmentVersion,
        commitment: invoice.commitment,
        merchantAuthorization: invoice.merchantAuthorization,
        expiry: invoice.expiry,
        status: InvoiceStatus.EXPIRED,
        settlementNullifier: invoice.settlementNullifier,
        escrowCoinCommitment: invoice.escrowCoinCommitment,
        receiptCommitment: invoice.receiptCommitment,
        claimed: invoice.claimed
    });
}

export pure circuit verifyReceipt(
    invoiceId: Bytes<32>,
    settlementNullifier: Bytes<32>,
    amount: Uint<128>,
    tokenId: Bytes<32>,
    receiptSecret: Bytes<32>,
    expectedReceiptCommitment: Bytes<32>
): Boolean {
    return deriveReceiptCommitment(
        invoiceId,
        settlementNullifier,
        amount,
        tokenId,
        receiptSecret
    ) == expectedReceiptCommitment;
}

export circuit rotateRegistryAdmin(
    currentAdminSecret: Bytes<32>,
    newAdminAuthorizationCommitment: Bytes<32>
): [] {
    assert(
        deriveRegistryAdminAuthorization(currentAdminSecret) == registryAdminAuthorization,
        "unauthorized registry admin rotation"
    );
    assert(
        newAdminAuthorizationCommitment != default<Bytes<32>>,
        "new registry admin authorization is required"
    );
    registryAdminAuthorization = disclose(newAdminAuthorizationCommitment);
}

export circuit registerQuoteProvider(
    providerId: Bytes<32>,
    providerAuthorizationCommitment: Bytes<32>,
    registryAdminSecret: Bytes<32>
): [] {
    assert(
        deriveRegistryAdminAuthorization(registryAdminSecret) == registryAdminAuthorization,
        "unauthorized quote provider registration"
    );
    assert(providerId != default<Bytes<32>>, "quote provider id is required");
    assert(
        providerAuthorizationCommitment != default<Bytes<32>>,
        "quote provider authorization is required"
    );
    assert(!quoteProviderIds.member(disclose(providerId)), "quote provider already exists");
    quoteProviderIds.insert(disclose(providerId));
    quoteProviderAuthorizations.insert(
        disclose(providerId),
        disclose(providerAuthorizationCommitment)
    );
}

export circuit rotateQuoteProvider(
    providerId: Bytes<32>,
    newProviderAuthorizationCommitment: Bytes<32>,
    registryAdminSecret: Bytes<32>
): [] {
    assert(
        deriveRegistryAdminAuthorization(registryAdminSecret) == registryAdminAuthorization,
        "unauthorized quote provider rotation"
    );
    assert(quoteProviderIds.member(disclose(providerId)), "quote provider does not exist");
    assert(
        newProviderAuthorizationCommitment != default<Bytes<32>>,
        "new quote provider authorization is required"
    );
    quoteProviderAuthorizations.insert(
        disclose(providerId),
        disclose(newProviderAuthorizationCommitment)
    );
}

export circuit removeQuoteProvider(
    providerId: Bytes<32>,
    registryAdminSecret: Bytes<32>
): [] {
    assert(
        deriveRegistryAdminAuthorization(registryAdminSecret) == registryAdminAuthorization,
        "unauthorized quote provider removal"
    );
    assert(quoteProviderIds.member(disclose(providerId)), "quote provider does not exist");
    quoteProviderIds.remove(disclose(providerId));
    quoteProviderAuthorizations.remove(disclose(providerId));
}

export circuit registerQuote(
    quoteId: Bytes<32>,
    providerId: Bytes<32>,
    quoteCommitment: Bytes<32>,
    expiry: Uint<64>,
    providerSecret: Bytes<32>
): [] {
    assert(quoteId != default<Bytes<32>>, "quote id is required");
    assert(quoteCommitment != default<Bytes<32>>, "quote commitment is required");
    assert(!quoteIds.member(disclose(quoteId)), "quote already exists");
    assert(quoteProviderIds.member(disclose(providerId)), "quote provider is disabled");
    assert(blockTimeLt(disclose(expiry)), "quote expiry must be in the future");
    assert(
        deriveQuoteProviderAuthorization(providerId, providerSecret)
            == quoteProviderAuthorizations.lookup(disclose(providerId)),
        "unauthorized quote"
    );

    quoteIds.insert(disclose(quoteId));
    quotes.insert(disclose(quoteId), QuotePublicState {
        commitmentVersion: 1,
        commitment: disclose(quoteCommitment),
        providerId: disclose(providerId),
        expiry: disclose(expiry),
        consumed: false
    });
}

// A converted checkout accepts the exact alternative shielded token amount in
// the provider quote. It does not assume or invoke liquidity. A future Zswap
// adapter may atomically source this coin, but the contract remains correct when
// the payer already owns the accepted token.
export circuit payInvoiceWithQuote(
    invoiceId: Bytes<32>,
    merchantPrivateIdentity: Bytes<32>,
    requestedAmount: Uint<128>,
    requestedToken: Bytes<32>,
    invoiceNonce: Bytes<32>,
    invoiceRandomness: Bytes<32>,
    quoteId: Bytes<32>,
    providerId: Bytes<32>,
    paymentToken: Bytes<32>,
    acceptedPaymentAmount: Uint<128>,
    quoteRandomness: Bytes<32>,
    paymentSecret: Bytes<32>,
    receiptSecret: Bytes<32>,
    coin: ShieldedCoinInfo
): [] {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    assert(quoteIds.member(disclose(quoteId)), "quote does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    const quote = quotes.lookup(disclose(quoteId));

    assert(invoice.status == InvoiceStatus.OPEN, "invoice is not open");
    assert(blockTimeLt(invoice.expiry), "invoice has expired");
    assert(!quote.consumed, "quote already consumed");
    assert(blockTimeLt(quote.expiry), "quote has expired");
    assert(quote.providerId == providerId, "wrong quote provider");
    assert(quoteProviderIds.member(disclose(providerId)), "quote provider is disabled");
    assert(requestedAmount > 0, "requested amount must be positive");
    assert(acceptedPaymentAmount > 0, "accepted payment amount must be positive");
    assert(paymentToken != requestedToken, "conversion requires a different token");

    assert(
        deriveInvoiceCommitment(
            invoiceId,
            merchantPrivateIdentity,
            requestedAmount,
            requestedToken,
            invoiceNonce,
            invoiceRandomness,
            invoice.expiry
        ) == invoice.commitment,
        "invalid invoice opening"
    );
    assert(
        deriveQuoteCommitment(
            quoteId,
            providerId,
            invoiceId,
            requestedToken,
            requestedAmount,
            paymentToken,
            acceptedPaymentAmount,
            quote.expiry,
            quoteRandomness
        ) == quote.commitment,
        "invalid quote opening"
    );
    assert(coin.color == paymentToken, "wrong quoted payment token");
    assert(coin.value == acceptedPaymentAmount, "wrong quoted payment amount");

    const nullifier = derivePaymentNullifier(invoiceId, paymentSecret);
    assert(!paymentNullifiers.member(disclose(nullifier)), "payment replay");
    receiveShielded(disclose(coin));
    paymentNullifiers.insert(disclose(nullifier));

    invoices.insert(disclose(invoiceId), InvoicePublicState {
        commitmentVersion: invoice.commitmentVersion,
        commitment: invoice.commitment,
        merchantAuthorization: invoice.merchantAuthorization,
        expiry: invoice.expiry,
        status: InvoiceStatus.SETTLED,
        settlementNullifier: disclose(nullifier),
        escrowCoinCommitment: disclose(
            deriveEscrowCoinCommitment(coin.nonce, coin.color, coin.value)
        ),
        receiptCommitment: disclose(
            deriveReceiptCommitment(
                invoiceId,
                nullifier,
                acceptedPaymentAmount,
                paymentToken,
                receiptSecret
            )
        ),
        claimed: false
    });
    quotes.insert(disclose(quoteId), QuotePublicState {
        commitmentVersion: quote.commitmentVersion,
        commitment: quote.commitment,
        providerId: quote.providerId,
        expiry: quote.expiry,
        consumed: true
    });
}

// The encrypted wallet/card backup remains off-chain. The ledger stores only
// an integrity digest and a commitment-derived authorization value.

export circuit proveInvoiceSettlement(
    invoiceId: Bytes<32>,
    paidAmount: Uint<128>,
    paidToken: Bytes<32>,
    receiptSecret: Bytes<32>
): [] {
    assert(invoiceIds.member(disclose(invoiceId)), "invoice does not exist");
    const invoice = invoices.lookup(disclose(invoiceId));
    assert(invoice.status == InvoiceStatus.SETTLED, "invoice is not settled");
    assert(
        deriveReceiptCommitment(
            invoiceId,
            invoice.settlementNullifier,
            paidAmount,
            paidToken,
            receiptSecret
        ) == invoice.receiptCommitment,
        "invalid settlement disclosure"
    );
}
