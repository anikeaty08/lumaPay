{
  "include": [
    "src/index.ts",
    "src/managed/lumapay/contract/index.js",
    "src/managed/lumapay-core/contract/index.js",
    "src/managed/lumapay-campaigns/contract/index.js",
    "src/managed/lumapay-gift-cards/contract/index.js",
    "src/managed/lumapay-quote-checkout/contract/index.js",
    "src/managed/lumapay-backup-anchor/contract/index.js",
    "src/managed/lumapay-card-vault/contract/index.js"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "sourceMap": true,
    "declarationMap": true,
    "allowJs": true,
    "checkJs": false,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
